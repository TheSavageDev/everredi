# Server
PORT=5051
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Stripe
FRONTEND_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# RevenueCat
REVENUECAT_SECRET_API_KEY=rcb_...
REVENUECAT_WEBHOOK_SECRET=your_webhook_secret

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# Email (Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM=EverRedi <onboarding@resend.dev>
# SUPPORT_EMAIL_TO=support@everredi.com

# Cloud Tasks (optional)
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# CLOUD_TASKS_QUEUE_NAME=expiration-notifications
# API_BASE_URL=https://api.everredi.com

# Sentry (optional)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=1.0
