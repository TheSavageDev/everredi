{
  "expo": {
    "name": "EverRedi",
    "slug": "everredi",
    "scheme": "everredi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "ios": {
      "bundleIdentifier": "app.everredi",
      "usesAppleSignIn": true
    },
    "android": { "package": "app.everredi" },
    "experiments": { "typedRoutes": true }
  }
}
