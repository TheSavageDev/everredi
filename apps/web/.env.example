NEXT_PUBLIC_SUPABASE_URL=https://jszxqowkkyjmplbzbgvf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local split-process. Omit this in production so the browser uses same-origin /api,
# which Next rewrites to the Rust service.
NEXT_PUBLIC_API_URL=http://localhost:5051/api

# Rust API origin for server-side calls and the /api rewrite. Include it at build time.
# API_INTERNAL_URL=http://127.0.0.1:5051

# Shared with the Rust API — required for the daily alerts cron
CRON_SECRET=generate-a-long-random-secret

# Edge Config connection string (Dashboard → Storage → Edge Config)
# EDGE_CONFIG=

# Vercel Blob read/write token
# BLOB_READ_WRITE_TOKEN=

# Playwright against Deployment Protection
# VERCEL_AUTOMATION_BYPASS_SECRET=
# PLAYWRIGHT_BASE_URL=https://your-preview.vercel.app
