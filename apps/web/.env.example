NEXT_PUBLIC_SUPABASE_URL=https://jszxqowkkyjmplbzbgvf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local split-process (pnpm --filter api + web). On Vercel Services, omit this so the
# browser uses same-origin /api (public rewrite to the Nest service).
NEXT_PUBLIC_API_URL=http://localhost:5051/api

# Injected by Vercel service binding in production (do not set manually there):
# API_INTERNAL_URL=

# Shared with Nest — required for Cron / Queues / Workflow internal calls
CRON_SECRET=generate-a-long-random-secret

# Edge Config connection string (Dashboard → Storage → Edge Config)
# EDGE_CONFIG=

# Vercel Blob read/write token
# BLOB_READ_WRITE_TOKEN=

# Playwright against Deployment Protection
# VERCEL_AUTOMATION_BYPASS_SECRET=
# PLAYWRIGHT_BASE_URL=https://your-preview.vercel.app
