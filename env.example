# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
# Service Role Key (for backend/admin operations)
# Format: sb_secret_... (new) or legacy service_role key
# Found in: Project Settings → API → Service Role Key
SUPABASE_SECRET_KEY=your-service-role-key
# Publishable Key (for frontend/client operations - optional for backend)
# Format: sb_publishable_... (new) or legacy anon key
# Found in: Project Settings → API → Publishable Key
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server Configuration
PORT=5051
CORS_ORIGIN=http://localhost:3000

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
# Optional: Override default model (defaults to gemini-1.0-pro)
# GEMINI_MODEL=gemini-1.0-pro

# RevenueCat Configuration
REVENUECAT_SECRET_API_KEY=your-revenuecat-secret-api-key
# Webhook secret for verifying RevenueCat webhook requests
# Generate with: openssl rand -hex 32
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret